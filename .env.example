# Daily Dilemma env vars
#
# The only backend is Upstash Redis. In production these are injected
# automatically by the Vercel "Upstash" (or "Vercel KV") marketplace
# integration -- you should not need to set them by hand on Vercel.
#
# For local dev they are OPTIONAL: without them the app falls back to an
# in-process memory store (fine for a dev session; not persistent).

# Primary names (Vercel KV / Upstash marketplace):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternate names also supported by lib/redis.js:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
